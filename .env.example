# docker compose 用的单一环境文件：  cp .env.example .env   然后按注释改
#
# 这份文件同时喂给"后端容器"和"前端的构建参数"（见 docker-compose.yml），
# 所以 Google/GitHub 的 client id 只写一遍，不会出现前后端两处不一致。
#
# 不走 Docker、想在本机手动跑两个进程的话，看 backend/.env.example 与 web/.env.local.example
#（内容与这里一致，只是分成两份）。

# ── Django 基础 ──
# 生产必须换随机串：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 本地 http 下必须为 False，否则 cookie 带 Secure 不会被浏览器接受、登录直接失效；
# 生产（https）改成 True。DEBUG=False 时这两项的默认值就是 True，可省略。
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ── 数据库 ──
# compose 里 db 容器用这些值；POSTGRES_HOST 会被 compose 覆盖成 db
POSTGRES_DB=smartflashcards
POSTGRES_USER=smartflashcards
POSTGRES_PASSWORD=change-me-please
POSTGRES_PORT=5432

# ── Google 登录 ──
# Google Cloud Console → 凭据 → OAuth 2.0 客户端 ID（Web 应用），授权回调地址填
#   http://localhost:3000/login         （本地）
#   https://你的域名/login               （生产）
# Google 允许注册多个回调地址。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# ── GitHub 登录 ──
# GitHub → Settings → Developer settings → OAuth Apps → 新建
#   Authorization callback URL 只允许填一个：
#     http://localhost:8000/api/auth/github/callback   （本地，注意是后端端口 8000）
#     https://你的域名/api/auth/github/callback         （生产，走 nginx 把 /api/ 交给后端）
# 本地与生产请各建一个 App —— 一个 App 只能有一个回调地址，GitHub 会逐字校验。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ── 站点地址 ──
# 后端用：GitHub 回调中转回前端时的固定落点（回调由 GitHub 服务器发起，Host 头不可信）
FRONTEND_ORIGIN=http://localhost:3000
# 前端用（构建期注入）：canonical / OpenGraph / metadataBase
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前端环境变量模板：  cp .env.local.example .env.local
#
# ⚠️ NEXT_PUBLIC_* 是**构建期**内联进产物里的：
#    · 本地开发改完重启 dev server 即可
#    · docker / 生产构建要通过 build args（或构建前就写好 .env.local）传进去，
#      只在运行期给环境变量是没用的

# 后端地址。服务端组件、BFF 代理、中间件都用它（必须能被 Next 进程访问到）
DJANGO_API_BASE=http://127.0.0.1:8000

# 两个 OAuth 的公开 client id（不是 secret，授权码流程里本来就会出现在浏览器 URL 上）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# GitHub 只允许注册一个回调地址且逐字校验，所以这里写死；必须与 GitHub 控制台里填的一致
#   本地  http://localhost:3000/api/auth/github/callback
#   生产  https://你的域名/api/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# 站点规范地址（canonical / OpenGraph / metadataBase），生产填真实域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

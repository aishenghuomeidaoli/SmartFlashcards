# SmartFlashcards（开源版）后端环境变量模板
#   cp .env.example .env   然后按下面的说明改；.env 不要提交
#
# 本地最省事的跑法：仓库根目录 docker compose up，db 与后端都在 compose 里
# （compose 会覆盖 POSTGRES_HOST=db 等几项，见 docker-compose.yml）。
# 想在本机直接跑后端就照这份文件的默认值来。

# ── Django 基础 ──
# 生产必须换成随机串：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# DEBUG=False 时 ALLOWED_HOSTS 不匹配会让所有接口返回 400，而不是报错日志
ALLOWED_HOSTS=localhost,127.0.0.1

# ── 数据库（只支持 PostgreSQL）──
POSTGRES_DB=smartflashcards
POSTGRES_USER=smartflashcards
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# ── Google 登录 ──
# Google Cloud Console → OAuth 2.0 客户端，并授权回调地址 http://localhost:3000/login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 只是兜底：前端会把实际使用的 redirect_uri 一起传上来（支持 apex / www / localhost 多入口）
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# ── GitHub 登录 ──
# GitHub → Settings → Developer settings → OAuth Apps，回调地址填
#   http://localhost:3000/api/auth/github/callback   （本地）
#   https://你的域名/api/auth/github/callback         （生产）
# GitHub 只允许注册一个回调地址且逐字校验，所以本地/生产要各注册一个 App。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── 前端地址 ──
# GitHub 回调（由 GitHub 服务器发起，Host 头不可信）把 code 转交回前端时用的固定地址
FRONTEND_ORIGIN=http://localhost:3000

# ── 反向代理（生产必看）──
# nginx → gunicorn 是 http，Django 靠这个头知道外侧是 https（admin 的 CSRF 校验依赖它）
# 不在 nginx 后面、直接跑 http 时把这两项设 False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# 站点有多个域名入口（apex + www）时才需要，同源请求不必填
CSRF_TRUSTED_ORIGINS=

# ── CORS ──
# 走 Next 的 /bff 同源代理时用不到；直连 API 调试时才需要
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
